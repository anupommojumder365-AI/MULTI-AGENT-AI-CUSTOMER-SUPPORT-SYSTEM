        "inputSchema": "{\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"summary\": {\"type\": \"string\"}, \"action\": {\"type\": \"string\"}, \"policy_ids\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"needs_human\": {\"type\": \"boolean\"}, \"confidence\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 1}, \"flags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"summary\", \"action\", \"policy_ids\", \"needs_human\", \"confidence\", \"flags\"]}"
