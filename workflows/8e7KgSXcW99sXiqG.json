      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx=$('Case context').first().json; const out=$input.first().json.output; if(!out || typeof out.summary!=='string' || !Array.isArray(out.policy_ids)) throw new Error('Invalid agent output'); const known=new Set((ctx.policies||[]).map(x=>x.id)); if(out.policy_ids.some(x=>!known.has(x))) throw new Error('Unknown policy citation'); return [{json:{...ctx,agents:[...(ctx.agents||[]),{agent:\"Knowledge Retrieval\",output:out,model:'openai/gpt-oss-20b'}]}}];"
